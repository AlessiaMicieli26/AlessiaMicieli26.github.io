# Canonical site URL used for SEO metadata, OpenGraph tags, robots.txt, and sitemap.xml
# Example: https://alessiamicieli26.github.io or https://alessiamicieli26.github.io/portfolio
NEXT_PUBLIC_SITE_URL=https://alessiamicieli26.github.io

# Optional subpath prefix ONLY if deploying under a GitHub Pages project subpath (e.g. /portfolio)
# Leave empty for root domains (Vercel, Netlify, custom domain, or <username>.github.io)
NEXT_PUBLIC_BASE_PATH=
